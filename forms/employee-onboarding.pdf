<<
/Type /Action
/S /JavaScript
/JS (\057\052\012 \052 Document\055level JavaScript for the HRFlow onboarding form\056\012 \052\012 \052 Acrobat runs an older JavaScript engine\054 so this file sticks to ES5\072\012 \052 var instead of let\057const\054 and no arrow functions or template strings\056\012 \052 Page numbers are zero\055based\054 matching Acrobat\047s doc\056pageNum\056\012 \052\057\012\012var PAGE\137COUNT \075 5\073\012var SUBMIT\137URL \075 \047http\072\057\057127\0560\0560\0561\0728000\057submit\047\073\012var MAX\137SALARY \075 9999999999\05699\073 \057\057 NUMERIC\05012\0542\051 in the database\012\012\057\057 Fields that must be filled before leaving each page\056\012var REQUIRED\137FIELDS \075 \133\012  \133\047first\137name\047\054 \047last\137name\047\054 \047email\047\054 \047phone\047\135\054\012  \133\047department\047\054 \047job\137title\047\054 \047start\137date\047\054 \047employment\137type\047\054 \047annual\137salary\047\054 \047remote\137employee\047\135\054\012  \133\047health\137plan\047\054 \047retirement\137percent\047\135\054\012  \133\047emergency\137name\047\054 \047emergency\137relationship\047\054 \047emergency\137phone\047\135\054\012  \133\047employee\137name\047\135\012\135\073\012\012\057\057 \055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\012\057\057 Helpers\012\057\057 \055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\012\012function fieldValue\050doc\054 name\051 \173\012  return String\050doc\056getField\050name\051\056valueAsString\051\056replace\050\05